# NutriGenie — Required Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env to version control.

# ── IBM watsonx.ai ──────────────────────────────────────────────────────────
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── IBM watsonx Orchestrate (optional — set USE_LOCAL_ORCHESTRATOR=true for dev) ─
WATSONX_ORCHESTRATE_URL=https://api.dl.watson-orchestrate.ibm.com
WATSONX_ORCHESTRATE_INSTANCE_ID=your_orchestrate_instance_id_here

# ── Orchestration mode ──────────────────────────────────────────────────────
# true  = use local AgentOrchestrator (default for development / hackathon demo)
# false = use real IBM watsonx Orchestrate API
USE_LOCAL_ORCHESTRATOR=true

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./nutrigenie.db

# ── ChromaDB path (relative to backend/ directory) ──────────────────────────
CHROMA_DB_PATH=../data/chroma_db

# ── FastAPI session secret ───────────────────────────────────────────────────
SECRET_KEY=replace_with_a_long_random_secret_string_here
